# Placeholders only. Never commit real values.
# --- Frontend (dev proxy) ---
VITE_BACKEND_URL=http://127.0.0.1:41500
# --- Backend (Step C onward) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=41500
ACCESS_TOKEN=change-me
ALLOWED_ORIGINS=https://localhost:5173
# Optional LLM intent provider (Step H). Server-side only.
LLM_API_KEY=
# Optional AI intent provider. Leave LLM_API_KEY empty to use the deterministic Hebrew grammar only.
# When set, the sentence the user types/says is sent to Anthropic; every result is re-validated against the command allowlist.
LLM_MODEL=claude-opus-5-5
